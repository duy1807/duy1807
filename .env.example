# ======== Lưu trữ / ví ========
DB_PATH=data/solbot.sqlite3
# Dùng MỘT trong hai (khuyến nghị keystore mã hóa, tạo bằng scripts/wallet_tool.py):
WALLET_ENCRYPTED_PATH=secrets/wallet.enc.json
# WALLET_KEYPAIR_PATH=secrets/id.json        # file solana-keygen, bắt buộc chmod 600
# WALLET_PASSPHRASE được nạp qua systemd credential (xem deploy/solbot.service), KHÔNG ghi vào đây.

# ======== Telegram ========
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=123456789

# ======== RPC HTTP (chỉ đọc/mô phỏng/xác minh — bot KHÔNG BAO GIỜ gửi giao dịch qua RPC) ========
RPC_URLS=https://your-primary-rpc.example,https://your-backup-rpc.example
SIM_RPC_URL=https://your-primary-rpc.example
# RPC hỗ trợ simulateBundle (Jito-Solana). Bắt buộc cho Bundle ×3/×5 ở LIVE.
BUNDLE_SIM_RPC_URL=
# Hai RPC ĐỘC LẬP (khác nhà cung cấp) để xác minh/đối soát
VERIFY_RPC_A_URL=https://provider-a.example
VERIFY_RPC_B_URL=https://provider-b.example

# ======== Yellowstone gRPC ========
GRPC_ENDPOINT=your-grpc-host.example:443
GRPC_TOKEN=
GRPC_TLS=true
GRPC_COMMITMENT=processed

# ======== Jito (Tokyo) ========
JITO_URL=https://tokyo.mainnet.block-engine.jito.wtf
JITO_UUID=
# JITO_EXTRA_URLS=https://mainnet.block-engine.jito.wtf   # gửi CÙNG bytes đã ký song song (tùy chọn)

# ======== Jupiter ========
JUPITER_BASE_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=

# ======== An toàn (chỉ operator đổi được, không đổi qua Telegram) ========
ALLOW_LIVE=false
SNAPSHOT_MAX_AGE_MS=600
HARD_MAX_SOL_PER_TX=5
HARD_MAX_SOL_PER_ORDER=25
HARD_MAX_TIP_SOL=0.05
LOG_LEVEL=INFO
